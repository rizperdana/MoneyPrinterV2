/* MoneyPrinterV2 - Flexoki Dark Theme */

/* Base - Dark theme */
Screen {
    background: #100F0F;  /* black */
    color: #FFFFFF;       /* tx */
}

/* Header and Footer - ui-2 */
Header {
    background: #1C1B1A;  /* bg-2 */
    color: #FFFFFF;
}

Footer {
    background: #1C1B1A;
    color: #6F6E69;       /* tx-2 */
}

/* Sidebar - bg */
#sidebar {
    background: #100F0F;
    width: 180;
    border-right: solid #282726;  /* ui */
}

.sidebar-header {
    background: #100F0F;
    color: #6F6E69;           /* tx-2 */
    text-align: center;
    padding: 1;
}

.nav-item {
    margin: 1;
}

/* Buttons - use cyan for primary */
Button {
    background: #3AA99F;    /* cyan-400 */
    color: #100F0F;
    border: none;
    padding: 1 3;
}

Button:hover {
    background: #3AA99F;
}

Button:focus {
    background: #3AA99F;
}

/* Secondary button */
#sidebar Button {
    background: transparent;
    color: #6F6E69;         /* tx-2 */
    border: none;
    text-align: left;
    width: 100%;
}

#sidebar Button:hover {
    background: #1C1B1A;     /* bg-2 */
    color: #B7B5AC;          /* tx-3 */
}

#sidebar Button:focus {
    background: #1C1B1A;
}

/* Input fields - ui-3 */
Input {
    background: #343331;       /* ui-2 */
    color: #FFFFFF;
    border: solid #403E3C;     /* ui-3 */
    padding: 1 2;
}

Input:focus {
    border: solid #3AA99F;     /* cyan */
}

/* Labels - tx-2 */
Label {
    color: #B7B5AC;          /* tx-3 */
}

/* Static text */
Static {
    color: #FFFFFF;
}

/* DataTable */
DataTable {
    background: transparent;
    color: #FFFFFF;
}

/* Screen headers */
.screen-header {
    background: #100F0F;
    padding: 2;
    color: #3AA99F;          /* cyan - accent */
    text-style: bold;
}

/* Form labels */
.form-label {
    color: #6F6E69;         /* tx-2 */
    width: 15;
}

/* Stats - ui */
.stat-card {
    background: #282726;      /* ui */
    border: solid #343331;  /* ui-2 */
    padding: 2;
}

.stat-card-title {
    color: #6F6E69;        /* tx-2 */
}

.stat-card-value {
    color: #FFFFFF;
}

/* Pipeline steps - use Flexoki accent colors */
.step-pending {
    color: #6F6E69;         /* tx-2 */
}

.step-active {
    color: #DA702C;         /* orange-400 - warning */
}

.step-complete {
    color: #879A39;         /* green-400 - success */
}

.step-error {
    color: #D14D41;         /* red-400 - error */
}

/* Section headers */
.section-header {
    color: #6F6E69;         /* tx-2 */
    padding: 1;
}

/* Main layout */
#main-layout {
    layout: horizontal;
    height: 100%;
    width: 100%;
}

#sidebar {
    background: #100F0F;
    width: 180;
    min-width: 180;
    max-width: 180;
    height: 100%;
}

#content-area {
    layout: vertical;
    width: 1fr;
    height: 100%;
    background: #100F0F;
}

/* Toast notifications */
.toast-container {
    width: 40;
    height: auto;
    align: center top;
    background: #1C1B1A;
    border: solid #343331;
    padding: 1;
}

.toast-error {
    color: #D14D41;          /* red */
}

.toast-success {
    color: #879A39;         /* green */
}

.toast-info {
    color: #3AA99F;         /* cyan */
}

/* Retry button */
.retry-btn {
    margin: 1;
}

/* Settings hints */
.hint {
    color: #6F6E69;         /* tx-2 */
    padding: 1;
}

.spacer {
    height: 1;
}

/* DataTable styling */
DataTable {
    background: transparent;
}