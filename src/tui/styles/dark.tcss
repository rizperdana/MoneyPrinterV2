/* MoneyPrinterV2 Dark Theme */

Screen {
    background: #0D0D0D;
    color: #FFFFFF;
}

/* Header and Footer */
Header {
    background: #1A1A1A;
    color: #FFFFFF;
}

Footer {
    background: #1A1A1A;
    color: #A1A1AA;
}

/* Sidebar */
#sidebar {
    background: #0D0D0D;
    width: 180;
}

.sidebar-header {
    background: #0D0D0D;
    color: #A1A1AA;
    text-align: center;
    padding: 1;
}

.nav-item {
    margin: 1;
}

/* Common widgets - Flexoki Cyan */
Button {
    background: #24837B;
    color: white;
    border: none;
    padding: 1 3;
}

Button:hover {
    background: #3AA99F;
}

Button:focus {
    background: #3AA99F;
}

/* Input fields */
Input {
    background: #262626;
    color: #FFFFFF;
    border: solid #333333;
    padding: 1 2;
}

Input:focus {
    border: solid #24837B;
}

/* Labels */
Label {
    color: #FFFFFF;
}

/* Static text */
Static {
    color: #FFFFFF;
}

/* DataTable */
DataTable {
    background: transparent;
    color: #FFFFFF;
}

/* Screen headers */
.screen-header {
    background: #0D0D0D;
    padding: 2;
    color: #FFFFFF;
}

/* Form labels */
.form-label {
    color: #A1A1AA;
    width: 15;
}

/* Stats */
.stat-card {
    background: #1A1A1A;
    border: solid #262626;
    padding: 2;
}

.stat-card-title {
    color: #A1A1AA;
}

.stat-card-value {
    color: #FFFFFF;
}

/* Pipeline steps */
.step-pending {
    color: #71717A;
}

.step-active {
    color: #F59E0B;
}

.step-complete {
    color: #10B981;
}

.step-error {
    color: #EF4444;
}

/* Section headers */
.section-header {
    color: #A1A1AA;
    padding: 1;
}

/* Main layout: sidebar + content area */
#main-layout {
    layout: horizontal;
    height: 100%;
    width: 100%;
}

#sidebar {
    background: #0D0D0D;
    width: 180;
    min-width: 180;
    max-width: 180;
    height: 100%;
    border-right: solid #1A1A1A;
}

#content-area {
    layout: vertical;
    width: 1fr;
    height: 100%;
    background: #0D0D0D;
}

/* Toast / notification overlay */
.toast-container {
    width: 40;
    height: auto;
    align: center top;
    background: #1A1A1A;
    border: solid #333333;
    padding: 1;
}

.toast-error {
    color: #AF3029;
}

.toast-success {
    color: #66800B;
}

.toast-info {
    color: #24837B;
}

/* Retry button */
.retry-btn {
    margin: 1;
}

/* Settings hints */
.hint {
    color: #71717A;
    padding: 1;
}

.spacer {
    height: 1;
}

/* Nav item styling */
#sidebar Button {
    background: transparent;
    color: #71717A;
    border: none;
    text-align: left;
    width: 100%;
}

#sidebar Button:hover {
    background: #1A1A1A;
    color: #A1A1AA;
}

#sidebar Button:focus {
    background: #1A1A1A;
}