/* MoneyPrinterV2 - Flexoki Dark Theme */

/* Base */
Screen {
    background: #100F0F;
    color: #FFFFFF;
}

Header {
    background: #1C1B1A;
    color: #FFFFFF;
}

Footer {
    background: #1C1B1A;
    color: #6F6E69;
}

/* Sidebar */
#sidebar {
    background: #100F0F;
    width: 160;
    border-right: solid #282726;
}

.sidebar-header {
    background: #100F0F;
    color: #6F6E69;
    text-align: center;
    padding: 1;
}

/* Nav items */
#sidebar Button {
    background: transparent;
    color: #6F6E69;
    border: none;
    text-align: left;
    width: 100%;
    padding: 1;
}

#sidebar Button:hover {
    background: #1C1B1A;
    color: #B7B5AC;
}

#sidebar Button:focus {
    background: #1C1B1A;
}

/* Buttons */
Button {
    background: #3AA99F;
    color: #100F0F;
    border: none;
    padding: 1;
}

Button:hover {
    opacity: 0.9;
}

Button:focus {
    opacity: 0.85;
}

/* Input */
Input {
    background: #1C1B1A;
    color: #FFFFFF;
    border: solid #282726;
    padding: 1;
}

Input:focus {
    border: solid #3AA99F;
}

/* Labels */
Label {
    color: #B7B5AC;
}

/* Static */
Static {
    color: #FFFFFF;
}

/* DataTable */
DataTable {
    background: transparent;
    color: #FFFFFF;
}

/* Screen headers */
.screen-header {
    background: #100F0F;
    padding: 2;
    color: #3AA99F;
}

/* Form labels */
.form-label {
    color: #6F6E69;
    width: 15;
}

/* Stat cards */
.stat-card {
    background: #1C1B1A;
    border: solid #282726;
    padding: 2;
}

.stat-card-title {
    color: #6F6E69;
}

.stat-card-value {
    color: #FFFFFF;
}

/* Steps */
.step-pending { color: #6F6E69; }
.step-active { color: #DA702C; }
.step-complete { color: #879A39; }
.step-error { color: #D14D41; }

/* Section headers */
.section-header {
    color: #6F6E69;
    padding: 1;
}

/* Layout */
#main-layout {
    layout: horizontal;
    height: 100%;
    width: 100%;
}

#sidebar {
    width: 160;
    min-width: 160;
    max-width: 160;
    height: 100%;
}

#content-area {
    layout: vertical;
    width: 1fr;
    height: 100%;
    background: #100F0F;
}

/* Toast */
.toast-container {
    background: #1C1B1A;
    border: solid #282726;
    padding: 1;
}

.toast-error { color: #D14D41; }
.toast-success { color: #879A39; }
.toast-info { color: #3AA99F; }

/* Misc */
.hint {
    color: #6F6E69;
    padding: 1;
}

.spacer {
    height: 1;
}