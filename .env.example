# MoneyPrinterV2 Environment Variables
# Copy this to .env and fill in your values

# Cliproxy API (OpenAI-compatible LLM proxy)
CLIPROXY_API_KEY=your_cliproxy_api_key_here

# Cloudflare Workers AI (free SDXL, 100K/day)
# Option A: Official Cloudflare API (preferred)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
# Option B: Custom Worker (fallback)
CF_WORKER_URL=
CF_WORKER_API_KEY=

# Pollinations API (AI image generation fallback)
POLLINATIONS_API_KEY=

# Pixabay API (stock photo fallback)
PIXABAY_API_KEY=

# AssemblyAI (optional, for cloud STT)
ASSEMBLYAI_API_KEY=

# Reddit API (optional, enables PRAW auth instead of raw requests)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MoneyPrinterV2/1.0
